# AWS region
region = "us-east-1"

# SSH key 
key_name        = "k0s-key"
public_key_path = "../../../key_pair/k0s_key.pub"

# Networking
vpc_cidr = "10.0.0.0/16"
vpn_cidr = "10.8.0.0/24"

az_count = 3

# Replace these with the enabled AZs and approved Ubuntu 22.04 AMI ID
# supplied for your VocLabs account and selected region.
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]
ubuntu_2204_ami_id = "ami-REPLACE_WITH_APPROVED_UBUNTU_2204_AMI"

subnet_newbits = 8

public_subnet_indexes = [1, 2, 3]
k8s_subnet_indexes    = [11, 12, 13]
observ_subnet_indexes = [21, 22, 23]

openvpn_public_subnet_index = 2

k0s_nodes = {
  master = {
    subnet_index = 0
    private_ip   = "10.0.11.10"
  }

  worker1 = {
    subnet_index = 0
    private_ip   = "10.0.11.11"
  }

  worker2 = {
    subnet_index = 1
    private_ip   = "10.0.12.10"
  }

  worker3 = {
    subnet_index = 2
    private_ip   = "10.0.13.10"
  }
}

jenkins_nodes = {
  jenkins_master = {
    subnet_index = 1
    private_ip   = "10.0.22.10"
  }

  jenkins_worker = {
    subnet_index = 1
    private_ip   = "10.0.22.11"
  }
}

sonarqube_nodes = {
  sonarqube = {
    subnet_index = 2
    private_ip   = "10.0.23.10"
  }
}

# =========================
# Compute
# =========================
# The AMI is set explicitly above because the VocLabs role does not permit
# ec2:DescribeImages. Obtain the approved Ubuntu 22.04 AMI ID from the lab.

# Instance Type 
k0s_instance_type            = "t3.small"
observability_instance_type  = "t3.small"
jenkins_master_instance_type = "t3.small"
jenkins_worker_instance_type = "t3.small"
sonarqube_instance_type       = "t3.medium"
openvpn_instance_type        = "t3.micro"

# Jenkins root EBS volumes (GiB)
jenkins_master_root_volume_size = 30
jenkins_worker_root_volume_size = 30

# SonarQube root EBS volume (GiB)
sonarqube_root_volume_size = 30

# Ansible
ansible_inventory_dir = "../../../ansible-hub/inventories/staging"

# Application Load Balancer
alb_target_port = 30293
environment     = "staging"
